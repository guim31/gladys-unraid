                "es": "Alerta"
              }
            },
            {
              "value": "warning",
              "label": {
                "en": "Warning",
                "fr": "Avertissement",
                "de": "Warnung",
                "es": "Aviso"
              }
            },
            {
              "value": "info",
              "label": {
                "en": "Information",
                "fr": "Information",
                "de": "Information",
                "es": "Información"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "server_name",
          "type": "string",
          "label": {
