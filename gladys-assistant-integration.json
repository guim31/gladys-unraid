      "label": {
        "en": "Unraid notification",
        "fr": "Notification Unraid",
        "de": "Unraid-Benachrichtigung",
        "es": "Notificación de Unraid"
      },
      "description": {
        "en": "Unraid posted a new notification (alert, warning or information): SMART, temperature, array, update…",
        "fr": "Unraid a publié une nouvelle notification (alerte, avertissement ou information) : SMART, température, matrice, mise à jour…",
